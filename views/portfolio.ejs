      <div class="swiper-slide">
        <div class="two bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project2.webp", title: "Restaurant Management System", para: "Restaurant management system streamlines operations by handling reservations, orders, inventory, and billing in one system. It improves efficiency, enhances customer service, and provides valuable insights for better decision-making", path: "https://qabil.jobs/"}) %>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="three bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project3.webp", title: "Shopify Website", para: "Conversion Suite is an all-in-one suite of Shopify applications designed to help store owners boost conversions through FOMO (fear of missing out) tactics and enhanced customer engagement. The platform enables merchants to capture customer data and reconnect through various marketing channels, ultimately driving higher profits.", path: "https://ems-cloudbased.vercel.app/"}) %>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="two bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project2.webp", title: "Restaurant Management", para: "Restaurant management system streamlines operations by handling reservations, orders, inventory, and billing in one system. It improves efficiency, enhances customer service, and provides valuable insights for better decision-making", path: "https://qabil.jobs/"}) %>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="three bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project3.png", title: "Employee Management", para: "The Employee Management System simplifies HR tasks by tracking employee details, performance, and attendance in one centralized platform. It streamlines recruitment, payroll, and reporting processes, enhancing overall efficiency and organizational workflow.", path: "https://ems-cloudbased.vercel.app/"}) %>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="three bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project4.png", title: "Wedding Portal", para: "A nationwide platform that lists verified wedding vendors with moderated profiles, image and video galleries, and customer reviews.The portal includes dedicated dashboards for users, vendors, and administrators to manage interactions and content efficiently.Designed to streamline the vendor discovery and booking process for weddings.", path: "http://wedding.aabizsol.com"}) %>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="three bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project5.png", title: "You Think We Wrap", para: "An online shopping platform offering a seamless buying experience along with unique product packaging and gift-wrapping options.The portal includes user and admin dashboards for managing orders, inventory, and custom wrap preferences.Designed to enhance customer satisfaction through personalized presentation and delivery.", path: "http://ytww.aabizsol.com"}) %>
        </div>
      </div>
       <div class="swiper-slide">
        <div class="three bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project6.png", title: "NestChat App", para: "NestChat is a real-time MERN chat app featuring email login, messaging, and built-in audio/video calls.Designed for seamless, instant communication with rich multimedia support.", path: "https://audio-video-calling-app-frontend.onrender.com/sign-in"}) %>
