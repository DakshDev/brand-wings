<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Brand Wings | Portfolio</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />
  <!-- Link Swiper's CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <link rel="stylesheet" href="/css/output.css">
  <link rel="icon" href="/assets/images/fav-icon.png" type="image/png">
  <!-- Demo styles -->
  <style>
    .swiper, .swiper-wrapper {
      width: 100vw;
      height: 100vh;
    }

    .swiper-slide {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-position: center;
      background-size: cover;
    }

    .one, .two, .three{
        background-position: center center;
        background-attachment: fixed;
        background-size: cover;
        overflow: hidden;
        background-image: url("/assets/images/darkbg.png");
        padding: 0px 40px;
    }

  </style>
</head>

<body class="theme overflow-x-hidden" id="home_bg_img">
  <div class="blurBg"></div>

  <%- include("./components/header") %>

  <div class="main-container">
  <!-- Swiper -->
  <section class="swiper mySwiper h-screen">
    <div class="swiper-wrapper">
      <div class="swiper-slide">
        <div class="one bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project1.PNG", title: "Job Portal", para: "The Jobs Portal is a user-friendly platform specifically designed to help students connect with a wide range of employers. It offers access to valuable opportunities including internships, part-time jobs, and full-time positions and secure relevant job opportunities that align with their skills and career goals.", path: "https://qabil.jobs/"}) %>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="three bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project3.webp", title: "Shopify Website", para: "Conversion Suite is an all-in-one suite of Shopify applications designed to help store owners boost conversions through FOMO (fear of missing out) tactics and enhanced customer engagement. The platform enables merchants to capture customer data and reconnect through various marketing channels, ultimately driving higher profits.", path: "https://ems-cloudbased.vercel.app/"}) %>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="two bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project2.webp", title: "Restaurant Management", para: "Restaurant management system streamlines operations by handling reservations, orders, inventory, and billing in one system. It improves efficiency, enhances customer service, and provides valuable insights for better decision-making", path: "https://qabil.jobs/"}) %>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="three bg-black w-full h-full relative">
          <%- include("./components/projects", {imageUrl: "/assets/images/project3.png", title: "Employee Management", para: "The Employee Management System simplifies HR tasks by tracking employee details, performance, and attendance in one centralized platform. It streamlines recruitment, payroll, and reporting processes, enhancing overall efficiency and organizational workflow.", path: "https://ems-cloudbased.vercel.app/"}) %>
        </div>
      </div>
    </div>
    <div style="display: none;" class="swiper-button-next"></div>
    <div style="display: none;" class="swiper-button-prev"></div>
  </section>
  </div>

  <!-- Swiper JS -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

  <!-- Initialize Swiper -->
  <script>
    var swiper = new Swiper(".mySwiper", {
      spaceBetween: 30,
      effect: "fade",
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
    });
    
    
    
    
    
    // on wheel click
    let loaded = true;
     document.querySelector(".mySwiper").addEventListener('wheel', function(event) {
      

      if(!loaded) {
        setTimeout(() => {
          loaded = true;
        }, 50)
        return;
      };

      if (event.deltaY < 0) {
        // deltaY > 0 means scrolling down
        const nextButton = document.querySelector('.swiper-button-prev');
        if (nextButton) {
          nextButton.click(); // Simulate click
          loaded = false;
        }
      }
       
      if (event.deltaY > 0) {
        // deltaY > 0 means scrolling down
        const nextButton = document.querySelector('.swiper-button-next');
        if (nextButton) {
          nextButton.click(); // Simulate click
          loaded = false;
        }
      }
    
  }, { passive: true });
    
  </script>
</body>

</html>

