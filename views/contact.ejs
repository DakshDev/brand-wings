<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Brand Wings | Contact</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="icon" href="/assets/images/fav-icon.png" type="image/png">
</head>
<body id="contact_bg_img" class="theme">
  <div class="blurBg"></div>


  <!-- Header Section -->
  <%- include('components/header') %>
   <div class="relative h-full" data-scroll-container>
    <div class="relative h-full">
      <!-- Hero Section -->
      <section class="max-lg:px-10 h-4/5 p-20 py-32 flex justify-center items-center">
        <div class="max-lg:w-full w-[70%] grid gap-10">
          <h1 id="hero_sec_head_gsap" class="text-6xl font-open_sana_3 uppercase md:text-center">Contact Us</h1>
          <p id="hero_sec_para_gsap" class="max-md:w-full w-9/12 m-auto md:text-center text-lg">We’d love to hear from you! Whether you’re looking to start a new digital project, need help optimizing your online presence, or simply have a question about our services — our team is here to help. Fill out the form below or reach out through the contact details provided, and we’ll get back to you as soon as possible. Let’s work together to bring your digital ideas to life.</p>
        </div>
      </section>
      <!-- Contact Page -->
      <section class="bg-white flex justify-center">
        <div class="p-20 py-32 max-w-[1280px] w-full">
            <form action="#" class="space-y-5">
                <div>
                    <label for="email" class="block text-xl mb-2 font-open_sana_2 text-mainClr">Your email</label>
                    <input type="email" id="email" class="rounded-md border border-mainClr font-open_sana_2 text-mainClr w-full bg-[#f7f7f7] p-4 py-2.5" placeholder="example@gmail.com" required>
                </div>
                <div>
                    <label for="subject" class="block text-xl mb-2 font-open_sana_2 text-mainClr">Subject</label>
                    <input type="text" id="subject" class="rounded-md border border-mainClr font-open_sana_2 text-mainClr w-full bg-[#f7f7f7] p-4 py-2.5" placeholder="Let us know how we can help you" required>
                </div>
                <div class="sm:col-span-2">
                    <label for="message" class="block text-xl mb-2 font-open_sana_2 text-mainClr">Your message</label>
                    <textarea id="message" rows="6" class="rounded-md border border-mainClr font-open_sana_2 text-mainClr resize-none w-full bg-[#f7f7f7] p-4 py-2.5" placeholder="Leave a comment..."></textarea>
                </div>
                <button type="submit" class="secBtn p-4 capitalize">Send message</button>
            </form>
        </div>
      </section>
      <!-- Footer -->
      <%- include('components/footer') %>
    </div>
  </div>
        

<!-- Lenis -->
  <script src="https://unpkg.com/lenis@1.3.4/dist/lenis.min.js"></script> 

  <!-- Initialize Swiper -->
  <script>
    // Lenis
    // ===================================================
    const lenis = new Lenis({
      autoRaf: true,
    });

    lenis.on('scroll', (e) => {
      // console.log(e.animate.value);
    });
    // ===================================================






    // hero heading section
    gsap.from("#hero_sec_head_gsap, #hero_sec_para_gsap", {
      delay: 1,
      opacity: 0,
      y: 50,
      stagger: 0.5,
      duration: 1,
    });
    </script>

</body>
</html>