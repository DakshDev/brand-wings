<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Header</title>
</head>
<body>


	<nav class="fixed bg-[#0000009f] backdrop-blur-2xl left-0 top-0 z-50 w-full h-20 flex justify-center items-center p-5">

		<!-- Navbar Container -->
	<div class="w-full max-w-[1280px] mx-auto rounded-full flex justify-between items-center py-4 px-6 xl:px-10">
  <!-- Logo -->
  <h1 class="text-2xl xl:text-3xl font-open_sana_2">Brand Wings</h1>

  <!-- Desktop Nav Links -->
  <div class="hidden xl:flex justify-center items-center gap-4">
    <a href="/" class="linkButton gsap_nav_link">Home</a>
    <a href="/about" class="linkButton gsap_nav_link">About Us</a>
    <a href="/services" class="linkButton gsap_nav_link">Our Services</a>
    <a href="/portfolio" class="linkButton gsap_nav_link">Portfolio</a>
  </div>

  <!-- Action Button (Desktop) -->
  <div class="hidden xl:block">
    <a href="/contact" class="priBtn">Contact Us</a>
  </div>

  <!-- Mobile Menu Toggle -->
  <div class="xl:hidden">
    <button id="mobileMenuToggle" class="text-3xl focus:outline-none">
      ☰
    </button>
		</div>
	</div>

  </nav>

	<!-- Mobile Dropdown Menu -->
	<nav id="mobileMenu" class="hidden fixed left-0 top-20 z-50 w-full p-2.5">
		<div class="bg-[#0000009f] rounded-md backdrop-blur-2xl w-full flex justify-center flex-wrap items-center gap-5 p-5">
			<div class="flex gap-2 items-center justify-center flex-wrap">
				<a href="/" class="linkButton gsap_nav_link">Home</a>
				<a href="/about" class="linkButton gsap_nav_link">About Us</a>
				<a href="/services" class="linkButton gsap_nav_link">Our Services</a>
				<a href="/contact" class="linkButton gsap_nav_link">Portfolio</a>
			</div>
			<button class="priBtn">Contact Us</button>
		</div>
	</nav>


	<!-- JavaScript to Toggle Menu -->
	<script>
		const toggle = document.getElementById('mobileMenuToggle');
		const menu = document.getElementById('mobileMenu');

		document.body.addEventListener("click", () => {
			menu.classList.add("hidden")
		})

		menu.addEventListener("click", (e) => e.stopPropagation());
		toggle.addEventListener('click', (e) => {
			e.stopPropagation();
			menu.classList.toggle('hidden');
		});
	</script>
</body>
</html>