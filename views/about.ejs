<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/css/output.css" rel="stylesheet">
    <title>About Us - Your Company</title>
</head>
<body class="theme">

    <%- include('components/header') %>
 
   
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-20">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto text-center">
                <h1 class="text-5xl font-bold mb-6">About Our Company</h1>
                <p class="text-xl mb-8 opacity-90">
                    Leading the industry with innovation, excellence, and commitment to our clients' success for over two decades.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <span class="bg-white bg-opacity-20 px-4 py-2 rounded-full text-lg">
                        📅 Est. 2000
                    </span>
                    <span class="bg-white bg-opacity-20 px-4 py-2 rounded-full text-lg">
                        👥 500+ Employees
                    </span>
                    <span class="bg-white bg-opacity-20 px-4 py-2 rounded-full text-lg">
                        🌍 25+ Countries
                    </span>
                </div>
            </div>
        </div>
    </section>

    
    <section class="py-16">
        <div class="container mx-auto px-4">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-4xl font-bold mb-6 text-gray-800">Our Story</h2>
                    <p class="text-lg text-gray-600 mb-6">
                        Founded in 2000, our company has grown from a small startup to a global leader in technology solutions.
                        We've consistently pushed the boundaries of innovation while maintaining our core values of integrity,
                        excellence, and customer satisfaction.
                    </p>
                    <p class="text-lg text-gray-600 mb-8">
                        Today, we serve clients across 25 countries, delivering cutting-edge solutions that drive business
                        growth and digital transformation. Our team of experts is dedicated to turning complex challenges into
                        simple, effective solutions.
                    </p>
                    <button class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-medium transition-colors">
                        Learn More About Our Services
                    </button>
                </div>
                <div class="relative">
                    <img src="/images/company-building.jpg" alt="Company building" class="rounded-lg shadow-lg w-full" />
                </div>
            </div>
        </div>
    </section>

   
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-12 text-gray-800">Our Foundation</h2>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
                    <div class="text-6xl mb-6">🎯</div>
                    <h3 class="text-2xl font-bold mb-4 text-gray-800">Mission</h3>
                    <p class="text-gray-600">
                        To empower businesses worldwide with innovative technology solutions that drive growth, efficiency,
                        and sustainable success in the digital age.
                    </p>
                </div>

                <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
                    <div class="text-6xl mb-6">👁️</div>
                    <h3 class="text-2xl font-bold mb-4 text-gray-800">Vision</h3>
                    <p class="text-gray-600">
                        To be the global leader in transformative technology solutions, creating a connected world where
                        innovation knows no boundaries.
                    </p>
                </div>

                <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
                    <div class="text-6xl mb-6">❤️</div>
                    <h3 class="text-2xl font-bold mb-4 text-gray-800">Values</h3>
                    <p class="text-gray-600">
                        Integrity, Innovation, Excellence, Collaboration, and Customer Success guide everything we do and
                        every decision we make.
                    </p>
                </div>
            </div>
        </div>
    </section>

   
    <section class="py-16">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-12 text-gray-800">Our Impact</h2>
            <div class="grid md:grid-cols-4 gap-8">
                <div class="text-center">
                    <div class="text-5xl font-bold text-blue-600 mb-2">500+</div>
                    <p class="text-gray-600 font-medium">Team Members</p>
                </div>
                <div class="text-center">
                    <div class="text-5xl font-bold text-blue-600 mb-2">1000+</div>
                    <p class="text-gray-600 font-medium">Projects Completed</p>
                </div>
                <div class="text-center">
                    <div class="text-5xl font-bold text-blue-600 mb-2">25+</div>
                    <p class="text-gray-600 font-medium">Countries Served</p>
                </div>
                <div class="text-center">
                    <div class="text-5xl font-bold text-blue-600 mb-2">98%</div>
                    <p class="text-gray-600 font-medium">Client Satisfaction</p>
                </div>
            </div>
        </div>
    </section>

    
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-12 text-gray-800">Leadership Team</h2>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-white rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
                    <img src="/images/team/john-smith.jpg" alt="John Smith" class="w-32 h-32 rounded-full mx-auto mb-4 object-cover" />
                    <h3 class="text-xl font-bold mb-2 text-gray-800">John Smith</h3>
                    <p class="text-blue-600 font-medium mb-3">Chief Executive Officer</p>
                    <p class="text-gray-600 text-sm">20+ years of experience in technology leadership and business strategy.</p>
                </div>

                <div class="bg-white rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
                    <img src="/images/team/sarah-johnson.jpg" alt="Sarah Johnson" class="w-32 h-32 rounded-full mx-auto mb-4 object-cover" />
                    <h3 class="text-xl font-bold mb-2 text-gray-800">Sarah Johnson</h3>
                    <p class="text-blue-600 font-medium mb-3">Chief Technology Officer</p>
                    <p class="text-gray-600 text-sm">Expert in emerging technologies with a passion for innovation and digital transformation.</p>
                </div>

                <div class="bg-white rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
                    <img src="/images/team/michael-brown.jpg" alt="Michael Brown" class="w-32 h-32 rounded-full mx-auto mb-4 object-cover" />
                    <h3 class="text-xl font-bold mb-2 text-gray-800">Michael Brown</h3>
                    <p class="text-blue-600 font-medium mb-3">Chief Operating Officer</p>
                    <p class="text-gray-600 text-sm">Operational excellence leader with extensive experience in scaling global organizations.</p>
                </div>
            </div>
        </div>
    </section>

   
    <section class="py-16">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-12 text-gray-800">Awards & Recognition</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-white rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
                    <div class="text-4xl mb-4">🏆</div>
                    <p class="font-medium text-gray-800">Best Technology Company 2023</p>
                </div>
                <div class="bg-white rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
                    <div class="text-4xl mb-4">🏆</div>
                    <p class="font-medium text-gray-800">Innovation Excellence Award</p>
                </div>
                <div class="bg-white rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
                    <div class="text-4xl mb-4">🏆</div>
                    <p class="font-medium text-gray-800">Top Employer Certification</p>
                </div>
                <div class="bg-white rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
                    <div class="text-4xl mb-4">🏆</div>
                    <p class="font-medium text-gray-800">Customer Choice Award</p>
                </div>
            </div>
        </div>
    </section>

   
    <section class="py-16 bg-blue-600 text-white">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl font-bold mb-6">Ready to Work With Us?</h2>
            <p class="text-xl mb-8 opacity-90">
                Let's discuss how we can help transform your business with our innovative solutions.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
                <button class="bg-white text-blue-600 hover:bg-gray-100 px-8 py-3 rounded-lg font-medium transition-colors">
                    📧 Contact Us
                </button>
                <button class="border-2 border-white text-white hover:bg-white hover:text-blue-600 px-8 py-3 rounded-lg font-medium transition-colors">
                    📞 Schedule a Call
                </button>
            </div>
        </div>
    </section>

  
    <section class="py-12 bg-gray-800 text-white">
        <div class="container mx-auto px-4">
            <div class="grid md:grid-cols-3 gap-8 text-center">
                <div>
                    <div class="text-3xl mb-3">📍</div>
                    <h3 class="font-bold mb-2">Headquarters</h3>
                    <p class="text-gray-300">
                        123 Business Street<br>
                        New York, NY 10001
                    </p>
                </div>
                <div>
                    <div class="text-3xl mb-3">📞</div>
                    <h3 class="font-bold mb-2">Phone</h3>
                    <p class="text-gray-300">+1 (555) 123-4567</p>
                </div>
                <div>
                    <div class="text-3xl mb-3">📧</div>
                    <h3 class="font-bold mb-2">Email</h3>
                    <p class="text-gray-300">info@company.com</p>
                </div>
            </div>
        </div>
    </section>

 

</body>
</html>
