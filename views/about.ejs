<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="/css/output.css" rel="stylesheet" />
  <title>Brand Wings | About</title>
  <link rel="icon" href="/assets/images/fav-icon.png" type="image/png">
</head>
<body class="theme" id="about_bg_img">
  <div class="blurBg"></div>

  <%- include('components/header') %>

  <div class="relative h-full" data-scroll-container>
    <!-- Hero Section -->
    <section class="px-6 md:px-10 py-16 md:py-32 flex justify-center items-center min-h-[80vh]">
  <div class="w-full max-w-4xl grid gap-6 text-center">
    <h1 id="hero_sec_head_gsap" class="text-4xl sm:text-5xl md:text-6xl font-open_sana_3 uppercase">About Our Company</h1>
    <p id="hero_sec_para_gsap" class="max-md:w-full w-9/12 m-auto md:text-center text-lg">At Brand Wings,  we are passionate about crafting smart digital solutions that help businesses grow and thrive in the modern world. With a team of creative thinkers, tech experts, and problem solvers, we specialize in web development, digital marketing, branding, and innovative technology services.</p>
    </div>
</section>
    <!-- Our Story -->
   <section class="px-6 md:px-10 py-16 md:py-32 bg-themeClr">
  <div class="container mx-auto">
    <div id="our_story_gsap" class="grid gap-10 lg:grid-cols-2 items-center">
      <div>
        <h2 class="text-3xl sm:text-4xl font-open_sana_2 text-mainClr font-bold mb-6">Our Story</h2>
        <p class="text-base sm:text-lg text-gray-700 mb-6">
          Founded in 2000, our company has grown from a small startup to a global leader in technology solutions. We've consistently pushed the boundaries of innovation while maintaining our core values of integrity, excellence, and customer satisfaction.
        </p>
        <p class="text-base sm:text-lg text-gray-700 mb-8">
          Today, we serve clients across 25 countries, delivering cutting-edge solutions that drive business growth and digital transformation. Our team of experts is dedicated to turning complex challenges into simple, effective solutions.
        </p>
        <button class="secBtn">Learn More About Our Services</button>
      </div>
      <div class="w-full max-w-md mx-auto lg:block hidden">
        <img src="/assets/images/img-2.jpg" alt="Company building" class="rounded-lg shadow-lg w-full" loading="lazy"/>
      </div>
    </div>
  </div>
</section>

    <!-- Our Foundation -->
    <section class="max-lg:px-10 p-20 py-32 bg-priClr">
      <div id="foundation_gsap" class="container mx-auto flex flex-col gap-20">
        <h2 class="text-5xl font-open_sana_2 text-mainClr font-bold text-center">Our Foundation</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
            <div class="text-6xl mb-6">🎯</div>
            <h3 class="text-2xl font-bold mb-4 text-mainClr">Mission</h3>
            <p class="text-mainClr">
              To empower businesses worldwide with innovative technology solutions that drive growth, efficiency,
              and sustainable success in the digital age.
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
            <div class="text-6xl mb-6">👁️</div>
            <h3 class="text-2xl font-bold mb-4 text-mainClr">Vision</h3>
            <p class="text-mainClr">
              To be the global leader in transformative technology solutions, creating a connected world where
              innovation knows no boundaries.
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
            <div class="text-6xl mb-6">❤️</div>
            <h3 class="text-2xl font-bold mb-4 text-mainClr">Values</h3>
            <p class="text-mainClr">
              Integrity, Innovation, Excellence, Collaboration, and Customer Success guide everything we do and
              every decision we make.
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- Our Impact -->
    <section class="max-lg:px-10 p-20 py-32 bg-themeClr text-black">
      <div id="impact_gsap" class="container mx-auto">
        <h2 class="text-5xl font-bold text-center font-open_sana_2 mb-12 text-mainClr">Our Impact</h2>
        <div class="grid md:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="text-5xl font-bold text-secClr mb-2">500+</div>
            <p class="text-gray-700 font-medium">Team Members</p>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-secClr mb-2">1000+</div>
            <p class="text-gray-700 font-medium">Projects Completed</p>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-secClr mb-2">25+</div>
            <p class="text-gray-700 font-medium">Countries Served</p>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-secClr mb-2">98%</div>
            <p class="text-gray-700 font-medium">Client Satisfaction</p>
          </div>
        </div>
      </div>
    </section>
    <!-- Our Vision -->
   <section class="max-lg:px-10 p-20 py-32 bg-themeClr">
  <div id="vision_gsap" class="container mx-auto flex flex-col gap-20">
    <h2 class="text-5xl font-open_sana_2 text-mainClr font-bold text-center">Our Vision</h2>
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Text Content -->
      <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-shadow">
        <h3 class="text-2xl font-bold mb-6 text-mainClr">We </h3>
        <h3 class="text-2xl font-bold mb-4 text-yellow-600"> Evolve </h3> <h3 class="text-2xl font-bold mb-4 text-mainClr"> With You</h3>
        <p class="text-mainClr mb-6">
          Our vision at BRANDWINGS is to never see our clients vanish off the map of the industry. 
          We wish to keep our clients' website in a power boosted mode constantly to drive 
          traffic and raise conversion rates.
        </p>
        <p class="text-mainClr">
          We keep striving to find newer, better ways to provide our clients with comfort 
          when connecting with us to manifest their ideas into a reality.
        We measure our success by your business growth and digital transformation. 
         Our team is dedicated to turning your ideas into powerful online solutions
        </p>
      </div>
      
      <!-- Image Card -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
        <div class="relative h-full">
          <img 
            src="https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80" 
            alt="Team working together"
            class="w-full h-full"
            loading="lazy"
          >
        </div>
      </div>
    </div>
  </div>
</section>
    <!-- Awards & Recognition -->
    <section class="max-lg:px-10 p-20 py-32 bg-themeClr2 text-black">
      <div class="container mx-auto">
        <h2 class="text-5xl font-open_sana_2 text-mainClr font-bold text-center mb-12">Awards & Recognition</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-themeClr rounded-lg shadow-lg p-10 text-center hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-4">🏆</div>
            <p class="font-medium text-black">Best Technology Company 2023</p>
          </div>
          <div class="bg-themeClr rounded-lg shadow-lg p-10 text-center hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-4">🏆</div>
            <p class="font-medium text-black">Innovation Excellence Award</p>
          </div>
          <div class="bg-themeClr rounded-lg shadow-lg p-10 text-center hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-4">🏆</div>
            <p class="font-medium text-black">Top Employer Certification</p>
          </div>
          <div class="bg-themeClr rounded-lg shadow-lg p-10 text-center hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-4">🏆</div>
            <p class="font-medium text-black">Customer Choice Award</p>
          </div>
        </div>
      </div>
    </section>
    <!-- Ready to Work With Us -->
    <section class="max-lg:px-10 p-20 py-32 bg-priClr text-stone-800">
      <div class="container mx-auto text-center">
        <h2 class="text-4xl font-bold mb-6 text-mainClr">Ready to Work With Us?</h2>
        <p class="text-xl mb-8 opacity-90 text-mainClr">
          Let's discuss how we can help transform your business with our innovative solutions.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="secBtn capitalize">📧 Let's discuss with us</a>
        </div>
      </div>
    </section>
    <!-- Footer -->
    <div class="relative">
      <%- include('components/footer') %>
    </div>
  </div>


<!-- Lenis Smooth Scroll -->
<script src="https://unpkg.com/lenis@1.3.4/dist/lenis.min.js"></script>
<!-- GSAP -->
<script src="https://unpkg.com/gsap@3.12.5/dist/gsap.min.js"></script>
<!-- GSAP ScrollTrigger Plugin -->
<script src="https://unpkg.com/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

<script>
  // Register GSAP plugin
  gsap.registerPlugin(ScrollTrigger);

  // Initialize Lenis
  const lenis = new Lenis({
    smooth: true,
    lerp: 0.1,
    autoRaf: false,
  });

  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);

  // Sync Lenis with ScrollTrigger
  lenis.on('scroll', ScrollTrigger.update);

  // Hero Section Animation (on page load)
  gsap.from("#hero_sec_head_gsap, #hero_sec_para_gsap", {
    delay: 0.5,
    opacity: 0,
    y: 50,
    stagger: 0.4,
    duration: 1,
  });

  // Our Story Animation
  gsap.from("#our_story_gsap > div", {
    scrollTrigger: {
      trigger: "#our_story_gsap",
      start: "top 80%",
      toggleActions: "play none none none",
    },
    opacity: 0,
    x: 100,
    stagger: 0.3,
    duration: 1,
  });

  // Foundation Section Animation
  gsap.from("#foundation_gsap > h2, #foundation_gsap > div > div", {
    scrollTrigger: {
      trigger: "#foundation_gsap",
      start: "top 80%",
      toggleActions: "play none none none",
    },
    opacity: 0,
    y: 100,
    stagger: 0.2,
    duration: 1,
  });

  // Impact Section Animation
  gsap.from("#impact_gsap > h2, #impact_gsap > div > div", {
    scrollTrigger: {
      trigger: "#impact_gsap",
      start: "top 80%",
      toggleActions: "play none none none",
    },
    opacity: 0,
    y: 100,
    stagger: 0.2,
    duration: 1,
  });

  // Vision Section Animation
  gsap.from("#vision_gsap > h2, #vision_gsap > div > div", {
    scrollTrigger: {
      trigger: "#vision_gsap",
      start: "top 80%",
      toggleActions: "play none none none",
    },
    opacity: 0,
    y: 100,
    stagger: 0.2,
    duration: 1,
  });
</script>

  
</body>
</html>


