<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="/css/output.css" rel="stylesheet" />
  <title>About Us - Your Company</title>
</head>
<body class="bg-white text-black font-sans">

  <%- include('components/header') %>

  <!-- Hero Section -->
  <section class="bg-[#FBE8A6] text-black py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl font-bold mb-6">About Our Company</h1>
        <p class="text-xl mb-8 text-gray-700">
          Leading the industry with innovation, excellence, and commitment to our clients' success for over two decades.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <span class="bg-white px-4 py-2 rounded-full text-lg">
            📅 Est. 2000
          </span>
          <span class="bg-white px-4 py-2 rounded-full text-lg">
            👥 500+ Employees
          </span>
          <span class="bg-white  px-4 py-2 rounded-full text-lg">
            🌍 25+ Countries
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-16 bg-white text-black">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl font-bold mb-6">Our Story</h2>
          <p class="text-lg text-gray-700 mb-6">
            Founded in 2000, our company has grown from a small startup to a global leader in technology solutions.
            We've consistently pushed the boundaries of innovation while maintaining our core values of integrity,
            excellence, and customer satisfaction.
          </p>
          <p class="text-lg text-gray-700 mb-8">
            Today, we serve clients across 25 countries, delivering cutting-edge solutions that drive business
            growth and digital transformation. Our team of experts is dedicated to turning complex challenges into
            simple, effective solutions.
          </p>
          <button class="bg-[#FBE8A6] hover:bg-orange-200 text-black px-8 py-3 rounded-lg font-medium transition-colors">
            Learn More About Our Services
          </button>
        </div>
        <div class="relative">
          <img src="/images/company-building.jpg" alt="Company building" class="rounded-lg shadow-lg w-full" />
        </div>
      </div>
    </div>
  </section>

  <!-- Our Foundation -->
  <section class="py-16 bg-[#FBE8A6] text-black">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Our Foundation</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
          <div class="text-6xl mb-6">🎯</div>
          <h3 class="text-2xl font-bold mb-4">Mission</h3>
          <p>
            To empower businesses worldwide with innovative technology solutions that drive growth, efficiency,
            and sustainable success in the digital age.
          </p>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
          <div class="text-6xl mb-6">👁️</div>
          <h3 class="text-2xl font-bold mb-4">Vision</h3>
          <p>
            To be the global leader in transformative technology solutions, creating a connected world where
            innovation knows no boundaries.
          </p>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
          <div class="text-6xl mb-6">❤️</div>
          <h3 class="text-2xl font-bold mb-4">Values</h3>
          <p>
            Integrity, Innovation, Excellence, Collaboration, and Customer Success guide everything we do and
            every decision we make.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Impact -->
  <section class="py-16 bg-white text-black">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Our Impact</h2>
      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-5xl font-bold text-[#FBE8A6] mb-2">500+</div>
          <p class="text-gray-700 font-medium">Team Members</p>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-[#FBE8A6] mb-2">1000+</div>
          <p class="text-gray-700 font-medium">Projects Completed</p>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-[#FBE8A6] mb-2">25+</div>
          <p class="text-gray-700 font-medium">Countries Served</p>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-[#FBE8A6] mb-2">98%</div>
          <p class="text-gray-700 font-medium">Client Satisfaction</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership Team -->
  <section class="py-16 bg-white text-black">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Leadership Team</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-[#FBE8A6] rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
          <img src="/images/team/john-smith.jpg" alt="John Smith" class="w-32 h-32 rounded-full mx-auto mb-4 object-cover" />
          <h3 class="text-xl font-bold mb-2">John Smith</h3>
          <p class="text-black font-medium mb-3">Chief Executive Officer</p>
          <p class="text-gray-700 text-sm">20+ years of experience in technology leadership and business strategy.</p>
        </div>

        <div class="bg-[#FBE8A6] rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
          <img src="/images/team/sarah-johnson.jpg" alt="Sarah Johnson" class="w-32 h-32 rounded-full mx-auto mb-4 object-cover" />
          <h3 class="text-xl font-bold mb-2">Sarah Johnson</h3>
          <p class="text-black font-medium mb-3">Chief Technology Officer</p>
          <p class="text-gray-700 text-sm">Expert in emerging technologies with a passion for innovation and digital transformation.</p>
        </div>

        <div class="bg-[#FBE8A6] rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
          <img src="/images/team/michael-brown.jpg" alt="Michael Brown" class="w-32 h-32 rounded-full mx-auto mb-4 object-cover" />
          <h3 class="text-xl font-bold mb-2">Michael Brown</h3>
          <p class="text-black font-medium mb-3">Chief Operating Officer</p>
          <p class="text-gray-700 text-sm">Operational excellence leader with extensive experience in scaling global organizations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Awards & Recognition -->
  <section class="py-16 bg-white text-black">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Awards & Recognition</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-[#FBE8A6] rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
          <div class="text-4xl mb-4">🏆</div>
          <p class="font-medium text-black">Best Technology Company 2023</p>
        </div>
        <div class="bg-[#FBE8A6] rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
          <div class="text-4xl mb-4">🏆</div>
          <p class="font-medium text-black">Innovation Excellence Award</p>
        </div>
        <div class="bg-[#FBE8A6] rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
          <div class="text-4xl mb-4">🏆</div>
          <p class="font-medium text-black">Top Employer Certification</p>
        </div>
        <div class="bg-[#FBE8A6] rounded-lg shadow-lg p-6 text-center hover:shadow-xl transition-shadow">
          <div class="text-4xl mb-4">🏆</div>
          <p class="font-medium text-black">Customer Choice Award</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ready to Work With Us -->
  <section class="py-16 bg-[#FBE8A6] text-stone-800">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to Work With Us?</h2>
      <p class="text-xl mb-8 opacity-90">
        Let's discuss how we can help transform your business with our innovative solutions.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <button class="border-2 border-white text-black hover:bg-white hover:text-black px-8 py-3 rounded-lg font-medium transition">
          📧 Contact Us
        </button>
        <button class="border-2 border-white text-black hover:bg-white hover:text-black px-8 py-3 rounded-lg font-medium transition">
          📞 Schedule a Call
        </button>
      </div>
    </div>
  </section>

  <!-- Contact Info Footer -->
  <section class="py-12 bg-white text-black">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-3xl mb-3">📍</div>
          <h3 class="font-bold mb-2">Headquarters</h3>
          <p>123 Business Street<br>New York, NY 10001</p>
        </div>
        <div>
          <div class="text-3xl mb-3">📞</div>
          <h3 class="font-bold mb-2">Phone</h3>
          <p>+1 (555) 123-4567</p>
        </div>
        <div>
          <div class="text-3xl mb-3">📧</div>
          <h3 class="font-bold mb-2">Email</h3>
          <p>info@company.com</p>
        </div>
      </div>
    </div>
  </section>

  <%- include('components/footer') %>

</body>
</html>


