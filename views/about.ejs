<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="/css/output.css" rel="stylesheet" />
    <title>Brand Wings | About</title>
</head>
<body class="theme" id="about_bg_img">
  <div class="blurBg"></div>

  <%- include('components/header') %>

  <div class="relative h-full" data-scroll-container>
    <!-- Hero Section -->
    <section class="max-lg:px-10 h-4/5 p-20 py-32 flex justify-center items-center">
      <div class="max-lg:w-full w-[70%] grid gap-10">
        <h1 class="text-6xl font-open_sana_3 uppercase md:text-center">About Our Company</h1>
        <p class="max-md:w-full w-9/12 m-auto md:text-center text-lg">At Brand Wings,  we are passionate about crafting smart digital solutions that help businesses grow and thrive in the modern world. With a team of creative thinkers, tech experts, and problem solvers, we specialize in web development, digital marketing, branding, and innovative technology services.</p>
      </div>
    </section>
    <!-- Our Story -->
    <section class="max-lg:px-10 p-20 py-32 bg-themeClr">
      <div class="container mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl font-open_sana_2 text-mainClr font-bold mb-6">Our Story</h2>
            <p class="text-lg text-gray-700 mb-6">
              Founded in 2000, our company has grown from a small startup to a global leader in technology solutions.
              We've consistently pushed the boundaries of innovation while maintaining our core values of integrity,
              excellence, and customer satisfaction.
            </p>
            <p class="text-lg text-gray-700 mb-8">
              Today, we serve clients across 25 countries, delivering cutting-edge solutions that drive business
              growth and digital transformation. Our team of experts is dedicated to turning complex challenges into
              simple, effective solutions.
            </p>
            <button class="secBtn">Learn More About Our Services</button>
          </div>
          <div class="max-lg:hidden relative w-9/12 m-auto ">
            <img src="/assets/images/img-2.jpg" alt="Company building" class="rounded-lg shadow-lg w-full" />
          </div>
        </div>
      </div>
    </section>
    <!-- Our Foundation -->
    <section class="max-lg:px-10 p-20 py-32 bg-priClr">
      <div class="container mx-auto flex flex-col gap-20">
        <h2 class="text-5xl font-open_sana_2 text-mainClr font-bold text-center">Our Foundation</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
            <div class="text-6xl mb-6">🎯</div>
            <h3 class="text-2xl font-bold mb-4 text-mainClr">Mission</h3>
            <p class="text-mainClr">
              To empower businesses worldwide with innovative technology solutions that drive growth, efficiency,
              and sustainable success in the digital age.
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
            <div class="text-6xl mb-6">👁️</div>
            <h3 class="text-2xl font-bold mb-4 text-mainClr">Vision</h3>
            <p class="text-mainClr">
              To be the global leader in transformative technology solutions, creating a connected world where
              innovation knows no boundaries.
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-lg p-8 text-center hover:shadow-xl transition-shadow">
            <div class="text-6xl mb-6">❤️</div>
            <h3 class="text-2xl font-bold mb-4 text-mainClr">Values</h3>
            <p class="text-mainClr">
              Integrity, Innovation, Excellence, Collaboration, and Customer Success guide everything we do and
              every decision we make.
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- Our Impact -->
    <section class="max-lg:px-10 p-20 py-32 bg-themeClr text-black">
      <div class="container mx-auto">
        <h2 class="text-5xl font-bold text-center font-open_sana_2 mb-12 text-mainClr">Our Impact</h2>
        <div class="grid md:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="text-5xl font-bold text-secClr mb-2">500+</div>
            <p class="text-gray-700 font-medium">Team Members</p>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-secClr mb-2">1000+</div>
            <p class="text-gray-700 font-medium">Projects Completed</p>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-secClr mb-2">25+</div>
            <p class="text-gray-700 font-medium">Countries Served</p>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-secClr mb-2">98%</div>
            <p class="text-gray-700 font-medium">Client Satisfaction</p>
          </div>
        </div>
      </div>
    </section>
    <!-- Our Vision -->
   <section class="max-lg:px-10 p-20 py-32 bg-themeClr">
  <div class="container mx-auto flex flex-col gap-20">
    <h2 class="text-5xl font-open_sana_2 text-mainClr font-bold text-center">Our Vision</h2>
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Text Content -->
      <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-shadow">
        <h3 class="text-2xl font-bold mb-6 text-mainClr">We </h3>
        <h3 class="text-2xl font-bold mb-4 text-yellow-600"> Evolve </h3> <h3 class="text-2xl font-bold mb-4 text-mainClr"> With You</h3>
        <p class="text-mainClr mb-6">
          Our vision at BRANDWINGS is to never see our clients vanish off the map of the industry. 
          We wish to keep our clients' website in a power boosted mode constantly to drive 
          traffic and raise conversion rates.
        </p>
        <p class="text-mainClr">
          We keep striving to find newer, better ways to provide our clients with comfort 
          when connecting with us to manifest their ideas into a reality.
        We measure our success by your business growth and digital transformation. 
         Our team is dedicated to turning your ideas into powerful online solutions
        </p>
      </div>
      
      <!-- Image Card -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
        <div class="relative h-full">
          <img 
            src="https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80" 
            alt="Team working together"
            class="w-full h-full"
          >
        </div>
      </div>
    </div>
  </div>
</section>
    <!-- Awards & Recognition -->
    <section class="max-lg:px-10 p-20 py-32 bg-themeClr2 text-black">
      <div class="container mx-auto">
        <h2 class="text-5xl font-open_sana_2 text-mainClr font-bold text-center mb-12">Awards & Recognition</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-themeClr rounded-lg shadow-lg p-10 text-center hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-4">🏆</div>
            <p class="font-medium text-black">Best Technology Company 2023</p>
          </div>
          <div class="bg-themeClr rounded-lg shadow-lg p-10 text-center hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-4">🏆</div>
            <p class="font-medium text-black">Innovation Excellence Award</p>
          </div>
          <div class="bg-themeClr rounded-lg shadow-lg p-10 text-center hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-4">🏆</div>
            <p class="font-medium text-black">Top Employer Certification</p>
          </div>
          <div class="bg-themeClr rounded-lg shadow-lg p-10 text-center hover:shadow-xl transition-shadow">
            <div class="text-4xl mb-4">🏆</div>
            <p class="font-medium text-black">Customer Choice Award</p>
          </div>
        </div>
      </div>
    </section>
    <!-- Ready to Work With Us -->
    <section class="max-lg:px-10 p-20 py-32 bg-priClr text-stone-800">
      <div class="container mx-auto text-center">
        <h2 class="text-4xl font-bold mb-6 text-mainClr">Ready to Work With Us?</h2>
        <p class="text-xl mb-8 opacity-90 text-mainClr">
          Let's discuss how we can help transform your business with our innovative solutions.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="secBtn capitalize">📧 Let's discuss with us</a>
        </div>
      </div>
    </section>
    <!-- Footer -->
    <div class="relative">
      <%- include('components/footer') %>
    </div>
  </div>










