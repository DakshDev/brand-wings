<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Brand Wings | Services</title>
  <link rel="icon" href="/assets/images/fav-icon.png" type="image/png" />
  <link rel="stylesheet" href="/css/output.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>

<body class="theme" id="service_bg_img">
  <div class="blurBg"></div>

  <!-- Header -->
  <%- include("./components/header") %>

  <main class="relative" data-scroll-container>
    <!-- Hero Section -->
    <section class="px-6 sm:px-10 min-h-screen py-32 flex justify-center items-center text-center">
      <div class="w-full max-w-3xl space-y-10">
        <h1 id="hero_sec_head_gsap" class="text-4xl md:text-6xl font-open_sana_3 uppercase">Our Services</h1>
        <p id="hero_sec_para_gsap" class="max-md:w-full w-9/12 m-auto md:text-center text-lg">
          We offer tailored digital solutions designed to help your business grow, connect, and perform better online.
          From building powerful platforms to enhancing online visibility and automating your processes, our goal is to
          simplify technology for you while delivering real, measurable results.
        </p>
      </div>
    </section>

    <!-- Digital Services Section -->
    <section id="our_services_gsap" class="px-6 sm:px-10 py-32 bg-themeClr2 flex justify-center">
      <div id="services_gsap" class="w-full max-w-7xl flex flex-col items-center space-y-16">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-open_sana_3 text-gray-800">Digital Services</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
          <%- include("./components/serviceBox", {title: "creative design", para: "Our team of professional graphic and web designers will help you with unique and creative logo and website designs that will match your business." }) %>
          <%- include("./components/serviceBox", {title: "Web Development", para: "We help you develop the right website with a good user interface built after a lot of research in the industry to help you make the best out of it." }) %>
          <%- include("./components/serviceBox", {title: "Branding & Marketing", para: "Need help with branding and marketing to reach out to a larger audience? We can help you create a brand presence and marketing efforts." }) %>
          <%- include("./components/serviceBox", {title: "search engine optimization", para: "We offer professional SEO services that help businesses increase their visibility, drive organic traffic, Whether you're a small business, startup, or e-commerce brand."}) %>
          <%- include("./components/serviceBox", {title: "app development", para: "Are you looking to build a fast, secure, and modern web application for your business or startup? we offer professional web app development services tailored to your specific needs."}) %>
          <%- include("./components/serviceBox", {title: "ai chat bot", para: "We build custom AI-powered chatbots that help businesses save time, improve customer experience, and work 24/7 — even when your team is offline."}) %>
        </div>
      </div>
    </section>

    <!-- Clients Carousel -->
    <section class="bg-themeClr2 px-6 sm:px-10 pb-32">
      <div class="py-8 lg:py-16 mx-auto max-w-screen-xl">
        <h2 class="text-3xl md:text-4xl font-extrabold text-center text-gray-900 mb-16">Clients We Worked With</h2>
        <div class="relative">
          <div class="swiper mySwiper px-4">
            <div class="swiper-wrapper">
              <div class="swiper-slide"><%- include("./components/clients", {name: "Leslie Alexander", title: "Brand Marketing"}) %></div>
              <div class="swiper-slide"><%- include("./components/clients", {name: "Alex Lewis", title: "Brand Marketing"}) %></div>
              <div class="swiper-slide"><%- include("./components/clients", {name: "James A.", title: "Brand Marketing"}) %></div>
              <div class="swiper-slide"><%- include("./components/clients", {name: "Kim Allen", title: "Brand Marketing"}) %></div>
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Project Section -->
    <section id="have_project_idea_gsap" class="px-6 sm:px-10 py-32 space-y-20">
      <div class="max-w-7xl mx-auto bg-priClr rounded-lg overflow-hidden flex flex-col lg:flex-row">
        <div class="p-10 lg:w-1/3 flex flex-col justify-between space-y-6">
          <div>
            <h3 class="text-3xl font-semibold text-mainClr mb-4">Have a Project on Mind?</h3>
            <p class="text-mainClr text-base">We can help you bring your ideas to life. Let’s talk about what we can build and raise together.</p>
          </div>
          <button class="secBtn mt-4">Contact With Us</button>
        </div>
        <div class="relative lg:w-2/3">
          <img class="w-full h-full object-cover" src="/assets/images/img3.jpg" alt="" />
          <div class="absolute inset-0 bg-black/60"></div>
        </div>
      </div>
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row gap-12 items-center">
        <div class="md:w-1/2">
          <h4 class="text-4xl lg:text-5xl font-bold">Let us together build a flourishing business</h4>
        </div>
        <div class="md:w-1/2">
          <p class="text-xl text-gray-800">When connected with us, you aren’t growing your business alone. We have your back and put in our best to contribute to the growth of your entire team and organization.</p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <%- include("./components/footer") %>
  </main>

  <!-- JS Libraries -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="https://unpkg.com/gsap@3.12.5/dist/gsap.min.js"></script>
  <script src="https://unpkg.com/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script src="https://unpkg.com/lenis@1.3.4/dist/lenis.min.js"></script>

  <!-- Initialization Script -->
  <script>
    gsap.registerPlugin(ScrollTrigger);

    const lenis = new Lenis({ autoRaf: true });
    lenis.on('scroll', ScrollTrigger.update);

    const raf = (time) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);

    new Swiper(".mySwiper", {
      slidesPerView: 1,
      breakpoints: {
        640: { slidesPerView: 1 },
        768: { slidesPerView: 2 },
        1024: { slidesPerView: 3 },
      },
      spaceBetween: 20,
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      }
    });

    // Hero animation
    gsap.from("#hero_sec_head_gsap, #hero_sec_para_gsap", {
      opacity: 0,
      y: 50,
      delay: 0.3,
      duration: 1,
      stagger: 0.3
    });

    // Digital Services
    gsap.from("#services_gsap h2", {
      scrollTrigger: "#services_gsap",
      opacity: 0,
      y: 100,
      duration: 1
    });
    gsap.from("#services_gsap .grid > div", {
      scrollTrigger: "#services_gsap",
      opacity: 0,
      y: 100,
      duration: 1,
      stagger: 0.2
    });

    // Have a Project
    gsap.from("#have_project_idea_gsap", {
      scrollTrigger: "#have_project_idea_gsap",
      opacity: 0,
      y: 150,
      duration: 1
    });
  </script>
</body>
</html>
