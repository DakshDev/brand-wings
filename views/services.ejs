<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/css/output.css">
</head>

<style>
  .swiper {
      width: 100%;
      height: 100%;
    }

    .swiper-slide {
      text-align: center;
      font-size: 18px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .swiper-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .swiper {
      width: 100%;
      height: 300px;
      margin: 20px auto;
    }
</style>

<body class="theme" id="service_bg_img">
  <div class="blurBg"></div>

  <!-- Header -->
  <%- include("./components/header")%>
  <div class="relative h-full" data-scroll-container>
    <div class="relative h-full">
      <!-- Hero Section -->
      <section class="max-lg:px-10 h-4/5 p-20 py-32 flex justify-center items-center">
        <div class="max-lg:w-full w-[70%] grid gap-10">
          <h1 class="text-6xl font-open_sana_3 uppercase md:text-center">Our Services</h1>
          <p class="max-md:w-full w-9/12 m-auto md:text-center text-lg">We offer tailored digital solutions designed to help your business grow, connect, and perform better online. From building powerful platforms to enhancing online visibility and automating your processes, our goal is to simplify technology for you while delivering real, measurable results.</p>
        </div>
      </section>
      <!-- Digital Services -->
      <section id="our_services_gsap" class="max-lg:px-10 p-20 py-32 bg-themeClr2 flex justify-center">
        <div id="services_gsap" class="flex flex-col justify-center items-center gap-20 max-w-[1440px] w-full">
          <h1 class="text-5xl font-open_sana_3 text-gray-800">Digital Services</h1>
          <div class="max-lg:grid-cols-2 max-sm:grid-cols-1 grid grid-cols-3 gap-5">
            <%- include("./components/serviceBox", {title: "creative design", para: "Our team of professional graphic and web designers will help you with unique and creative logo and website designs that will match your business." }) %>
            <%- include("./components/serviceBox", {title: "Web Development", para: "We help you develop the right website with a good user interface built after a lot of research in the industry to help you make the best out of it." }) %>
            <%- include("./components/serviceBox", {title: "Branding & Marketing", para: "Need help with branding and marketing to reach out to a larger audience? We can help you create a brand presence and marketing efforts." }) %>
            <%- include("./components/serviceBox", {title: "search engine optimization", para: "We offer professional SEO services that help businesses increase their visibility, drive organic traffic, Whether you're a small business, startup, or e-commerce brand."}) %>
            <%- include("./components/serviceBox", {title: "app development", para: "Are you looking to build a fast, secure, and modern web application for your business or startup? we offer professional web app development services tailored to your specific needs."}) %>
            <%- include("./components/serviceBox", {title: "ai chat bot", para: "We build custom AI-powered chatbots that help businesses save time, improve customer experience, and work 24/7 — even when your team is offline."}) %>
          </div>
        </div>
      </section>
      <!-- Our Client  -->
      <section class="bg-themeClr2 p-20 py-32">
        <div class="py-8 lg:py-16 mx-auto max-w-screen-xl px-4">
            <h2 class="mb-8 lg:mb-16 text-3xl font-extrabold tracking-tight leading-tight text-center text-gray-900 dark:text-white md:text-4xl">Client’s we worked with</h2>
            <div swiperRef="" class="swiper mySwiper relative flex overflow-hidden">
              <div class="swiper-wrapper w-full flex gap-5">
                <div class="swiper-slide block"><%- include("./components/clients", {name: "Leslie Alexander", title: "Brand Marketing"}) %></div>
                <div class="swiper-slide block"><%- include("./components/clients", {name: "Leslie Alexander", title: "Brand Marketing"}) %></div>
                <div class="swiper-slide block"><%- include("./components/clients", {name: "Leslie Alexander", title: "Brand Marketing"}) %></div>
                <div class="swiper-slide block"><%- include("./components/clients", {name: "Leslie Alexander", title: "Brand Marketing"}) %></div>
              </div> 
              <div class="swiper-button-prev absolute top-1/2 -translate-y-1/2 left-0 p-5 py-10"><span class="hidden">left</span><svg viewBox="0 0 320 512" class="fill-secClr text-secClr h-12"><path d="M41.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 256 246.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/></svg></div>
              <div class="swiper-button-next absolute top-1/2 -translate-y-1/2 right-0 p-5 py-10 "><span class="hidden">right</span><svg viewBox="0 0 320 512" class="fill-secClr text-secClr h-12"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"/></svg></div>
            </div>
        </div>
      </section>
      <!-- Have a Project -->
      <section class="max-lg:px-10 p-20 py-32 flex flex-col items-center gap-20">
        <div class="max-lg:flex-col bg-priClr max-w-[1440px] w-full rounded-md overflow-hidden flex relative">
          <div class="lg:w-1/3 shrink-0 grid content-between p-10 gap-5">
            <div class="flex flex-col gap-10">
              <h1 class="text-4xl font-semibold text-mainClr">Have a Project on mind?</h1>
              <p class="text-lg text-mainClr">We can help you bring your ideas to life. Let’s talk about what we can build and raise together.</p>
            </div>
            <div>
              <button class="secBtn">Contact With Us</button>
            </div>
          </div>
          <div class="w-full relative">
            <div class="absolute left-0 top-0 w-full h-full bg-[#0000009d]"></div>
            <img class="w-full" src="/assets/images/img3.jpg" alt="">
          </div>
        </div>
        <div class="max-md:flex-col max-md:gap-10 flex gap-20 items-center max-w-[1440px] w-full">
          <div class="md:w-1/2">
            <h1 class="text-6xl font-bold">Let us together build a flourishing business</h1>
          </div>
          <div class="md:w-1/2">
            <p class="text-xl">When connected with us, you aren’t growing your business alone. We have your back and put in our best to contribute to the growth of your entire team and organization. So, if you are looking for the right agency that’ll help you build a good online presence and bring in more conversions and revenue, we are right here!</p>
          </div>
        </div>
      </section>
      <!-- Footer -->
      <%- include("./components/footer")%>
    </div>
  </div> 















    <!-- Swiper JS -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

  <!-- Initialize Swiper -->
  <script>
    var swiper = new Swiper(".mySwiper", {
      slidesPerView: 3,
      centeredSlides: true,
      spaceBetween: 30,
      pagination: {
        el: ".swiper-pagination",
        type: "fraction",
      },
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
    });

  </script>
</body>
</html>